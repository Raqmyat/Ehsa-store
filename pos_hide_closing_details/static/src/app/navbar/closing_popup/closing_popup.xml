<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" xml:space="preserve">
        <!-- 1. Hide header total amount -->
        <xpath expr="//div[hasclass('total-orders')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 2. Hide Cash Expected Amount -->
        <xpath expr="//span[contains(@t-esc, 'default_cash_details.amount')]/.." position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 3. Hide Cash Extra Details (Opening, Payments, Counted, Difference) -->
        <!-- We target all divs inside payment-methods-overview that have border-start (the muted detail lines) -->
        <xpath expr="//div[hasclass('payment-methods-overview')]//div[hasclass('border-start')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 4. Hide PaymentMethodBreakdown (Cash In/Out details) -->
        <xpath expr="//PaymentMethodBreakdown" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 5. Hide Non-Cash Row (Name and Amount) -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods']//div[hasclass('fs-3')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 6. Hide Non-Cash Details (Counted and Difference for non-cash) -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods']//div[hasclass('border-start')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>

        <!-- 7. Hide Daily Sale and Sale Details buttons -->
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
        <xpath expr="//SaleDetailsButton/.." position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
    </t>
</templates>
