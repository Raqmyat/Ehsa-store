<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" xml:space="preserve">
        <!-- Final Minimalist Hiding: Nuclear XPath + CSS injection -->
        <xpath expr="." position="inside">
            <style t-if="!canShowClosingDetails()">
                /* Hide everything except the input and notes */
                .total-orders,
                .payment-methods-overview,
                .PaymentMethodBreakdown,
                .AccordionItem,
                .accordion,
                .accordion h4,
                hr:first-of-type,
                .modal-footer .d-flex.gap-2:nth-child(2),
                SaleDetailsButton,
                .opening-notes-container {
                    display: none !important;
                    visibility: hidden !important;
                    height: 0 !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }
                /* Clean spacing for the remaining elements */
                .modal-body {
                    padding-top: 10px !important;
                }
            </style>
        </xpath>

        <!-- Secondary layer: XPath hiding for structural reliability -->
        <xpath expr="//div[hasclass('total-orders')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
        <xpath expr="//hr" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('opening-notes-container')]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
        <xpath expr="//t[@t-set-slot='footer']//div[hasclass('gap-2')][2]" position="attributes">
            <attribute name="t-if">canShowClosingDetails()</attribute>
        </xpath>
    </t>
</templates>
