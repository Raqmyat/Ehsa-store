<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" xml:space="preserve">
        <!-- Bulletproof Server Hiding using CSS Injection -->
        <xpath expr="." position="inside">
            <style t-if="!canShowClosingDetails()">
                /* Hide everything sensitive */
                .total-orders, 
                .payment-methods-overview, 
                .PaymentMethodBreakdown, 
                .cash-difference, 
                .amount, 
                .fs-3, 
                .border-start.ps-2, 
                [title*='Daily Sale'], 
                [t-on-click*='downloadSalesReport'], 
                SaleDetailsButton {
                    display: none !important;
                }
            </style>
        </xpath>
    </t>
</templates>
