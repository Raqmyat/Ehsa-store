<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Force standard_price to be visible in product template form -->
    <record id="product_template_form_view_force_standard_price" model="ir.ui.view">
        <field name="name">product.template.form.force.standard.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- إجبار ظهور standard_price بإزالة أي شروط invisible -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="readonly">0</attribute>
                <attribute name="groups"></attribute>
            </xpath>
        </field>
    </record>

    <!-- Force standard_price to be visible in product variant form -->
    <record id="product_product_form_view_force_standard_price" model="ir.ui.view">
        <field name="name">product.product.form.force.standard.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- إجبار ظهور standard_price بإزالة أي شروط invisible -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="readonly">0</attribute>
                <attribute name="groups"></attribute>
            </xpath>
        </field>
    </record>
</odoo>
